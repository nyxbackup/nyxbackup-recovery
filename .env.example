# OAuth client credentials for the Google Drive, OneDrive, and Dropbox
# backends.  Copy this file to `.env` (gitignored) and fill in the values from
# your OAuth app registrations before building.
#
# These serve two purposes:
#
#  1. BUILD TIME - the build scripts source `.env`, and the values are baked
#     into the binary (via `env!` / `option_env!`).  This is how the official
#     builds ship a working OAuth app.
#
#  2. RUNTIME (override / escape hatch) - the same variable names are also read
#     from the process environment at runtime and, when set (non-empty),
#     override the baked-in values.  So an end user (or a delegate) can point
#     the tool at THEIR OWN OAuth app - no rebuild needed - by exporting the
#     variable before launching.  The backup data lives in the user's own cloud
#     account, so a fresh app with read scope reaches the same backups.  This is
#     the wind-down protection for the three OAuth backends: if the project's
#     OAuth apps ever stop working, users are not locked out.
#
# OneDrive uses the public-client flow, so it has no secret (only CLIENT_ID).

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
ONEDRIVE_OAUTH_CLIENT_ID=

# -- Azure Trusted Signing (Windows code signing) ------------------------------
# When NYX_TS_PROFILE is set, the Windows build/MSI scripts sign the recovery
# .exe (at stage time) and the MSI itself via jsign (scripts/windows/sign_pe.sh).
# The private key stays in Microsoft's HSM; a short-lived cert is minted per
# request and RFC 3161 timestamped, so the signature stays valid after the leaf
# expires.  Same cert as the main Nyx Backup product.  Only AZURE_CLIENT_SECRET
# is sensitive - the rest are non-secret identifiers.  The service principal
# needs the "Trusted Signing Certificate Profile Signer" role on the account.
NYX_TS_ENDPOINT=eus.codesigning.azure.net
NYX_TS_ACCOUNT=YOUR_TRUSTED_SIGNING_ACCOUNT
NYX_TS_PROFILE=YOUR_CERTIFICATE_PROFILE
AZURE_TENANT_ID=YOUR_TENANT_ID
AZURE_CLIENT_ID=YOUR_SP_CLIENT_ID
AZURE_CLIENT_SECRET=YOUR_SP_CLIENT_SECRET
# Path to a jsign >= 6.0 jar if `jsign` is not on PATH (Ubuntu's apt jsign is
# 5.x and lacks the TRUSTEDSIGNING store type).  Machine-local; not committed.
#   curl -fsSL -o ~/.nyx-signing/jsign-7.1.jar \
#     https://repo1.maven.org/maven2/net/jsign/jsign/7.1/jsign-7.1.jar
NYX_JSIGN_JAR=/home/YOUR_USER/.nyx-signing/jsign-7.1.jar

# -- GPG release key (Linux package signing) -----------------------------------
# When NYX_SIGN_KEY_ID is set, the .deb scripts sign with debsigs and the .rpm
# script signs with rpmsign, both using the shared Nyx Backup release key
# (see scripts/linux/keys/README.md for the fingerprint and rotation log).
# A key id is not a secret, but the private key must be in the build host's GPG
# keyring - so set this to YOUR OWN key, not the Nyx release key.  Unset -> the
# packagers print "unsigned (dev build)" and still exit 0, so a release build
# that forgets it ships unsigned and looks clean.
NYX_SIGN_KEY_ID=YOUR_GPG_KEY_ID

# ---------------------------------------------------------------------
# macOS code signing + notarization (Mac build host only).
# Two DISTINCT Apple Developer ID certs, same Team ID as the main app.
# Unset -> an UNSIGNED .pkg, which Gatekeeper will warn about.  That
# matters more here than for the main app: this is the tool people run
# during a disaster recovery, often on a machine that is not theirs.
# ---------------------------------------------------------------------
APPLE_SIGNING_IDENTITY="Developer ID Application: <Name> (TEAMID)"
APPLE_INSTALLER_IDENTITY="Developer ID Installer: <Name> (TEAMID)"
APPLE_TEAM_ID=TEAMID
# Notarization: a profile stored once with `xcrun notarytool store-credentials`
APPLE_KEYCHAIN_PROFILE=nyx-notary
